# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env depoya girmez.

# Yönetim paneli (/yonetim) şifresi. Panelden değiştirilirse bu değer artık kullanılmaz.
ADMIN_SIFRE=

# Jürilerin ortak giriş şifresi. Panelden değiştirilirse bu değer artık kullanılmaz.
JURI_SIFRE=

# Yalnızca ilk çalıştırmada etkinlik bilgisine yazılır; sonra panelden değişir (boş bırakılabilir)
ETKINLIK_TARIH=
ETKINLIK_YER=

# İsteğe bağlı
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=.            # juri.db bu klasörde tutulur
# TRUST_PROXY=false     # ters vekil arkasında true (X-Forwarded-For okunur)
